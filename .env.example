# Polywork: paper-only research lab. Never put real wallet keys here.

# Database. Local dev uses the peer-auth socket; production (Railway) sets a
# full URL with credentials and SSL is auto-enabled by src/lib/db.ts.
POLYWORK_DB_URL=postgresql:///polywork

# Polymarket public APIs (no key needed for these)
POLYMARKET_GAMMA=https://gamma-api.polymarket.com
POLYMARKET_DATA=https://data-api.polymarket.com
POLYMARKET_CLOB=https://clob.polymarket.com
POLYMARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Optional real-time CLOB websocket; leave off for v1.
POLYMARKET_WS_ENABLED=false

# Liquidity gate for live runtime (skip markets below this 24h volume).
MIN_PRE_VOL_24H_USD=5000

# Ingestion tuning (only relevant when running scripts/ingest-*.ts).
INGEST_MAX_MARKETS=10000
INGEST_MIN_VOLUME=50000
INGEST_MAX_VOLUME=500000
INGEST_MIN_RESOLUTION_DATE=2024-01-01
INGEST_MAX_TRADES_PER_MARKET=3000
INGEST_CONCURRENCY=4

# Admin token. REQUIRED in production. Mutating routes (lab agent actions)
# require Authorization: Bearer <this token>. Generate with:
#   openssl rand -hex 32
# Min length 16 chars; <16 chars makes mutations refuse to run.
POLYWORK_ADMIN_TOKEN=

# Optional email notifications via Resend (https://resend.com).
POLYWORK_EMAIL_ENABLED=false
POLYWORK_EMAIL_FROM=
POLYWORK_EMAIL_TO=
RESEND_API_KEY=

# Connection pool size (default 8).
# POLYWORK_DB_POOL_MAX=8

# Force SSL behavior. Auto-detected from POLYWORK_DB_URL hostname; override
# only if needed. Values: require | disable
# PGSSLMODE=
